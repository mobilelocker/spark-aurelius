{
    "name": "laravel/spark-aurelius",
    "description": "Laravel Spark provides scaffolding for Laravel SaaS applications.",
    "keywords": ["laravel", "stripe", "billing", "scaffolding", "saas"],
    "license": "MIT",
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zip": "*",
        "erusev/parsedown": "^1.8",
        "firebase/php-jwt": "^v7.1",
        "intervention/image": "^4.3",
        "laravel/cashier": "^16.8"
    },
    "require-dev": {
        "mpociot/vat-calculator": "^3.26"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Spark\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "13.x-dev"
        }
    },
    "prefer-stable": true
}
